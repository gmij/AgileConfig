@page "/nodes"
@using AgileConfig.Server.UI.Blazor.Services
@using AgileConfig.Server.UI.Blazor.Models
@inject ApiClient ApiClient

<PageTitle>Server Nodes - AgileConfig</PageTitle>

<PageContainer Title="Server Node Management">
    <ChildContent>
        <Table TItem="ServerNodeModel"
               DataSource="@nodes"
               Loading="@loading">
            <ToolbarTemplate>
                <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Plus" OnClick="@ShowAddModal">
                    Add Node
                </Button>
            </ToolbarTemplate>
            <PropertyColumn Property="n => n.Address" Title="Address" />
            <PropertyColumn Property="n => n.Remark" Title="Remark" />
            <PropertyColumn Property="n => n.Status" Title="Status">
                @if (context.Status == 1)
                {
                    <Badge Status="@PresetColor.Success.ToString()" Text="Online" />
                }
                else
                {
                    <Badge Status="@PresetColor.Default.ToString()" Text="Offline" />
                }
            </PropertyColumn>
            <PropertyColumn Property="n => n.CreateTime" Title="Create Time">
                @context.CreateTime?.ToString("yyyy-MM-dd HH:mm:ss")
            </PropertyColumn>
            <PropertyColumn Property="n => n.LastHeartbeatTime" Title="Last Heartbeat">
                @context.LastHeartbeatTime?.ToString("yyyy-MM-dd HH:mm:ss")
            </PropertyColumn>
            <ActionColumn Title="Actions">
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Link" OnClick="@(() => ShowEditModal(context))">Edit</Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Popconfirm Title="@($"Delete node {context.Address}?")" OnConfirm="@(() => DeleteNode(context))">
                            <Button Type="@ButtonType.Link" Danger>Delete</Button>
                        </Popconfirm>
                    </SpaceItem>
                </Space>
            </ActionColumn>
        </Table>
    </ChildContent>
</PageContainer>

<Modal Title="@(isEditMode ? "Edit Node" : "Add Node")"
       @bind-Visible="@modalVisible"
       OnOk="@HandleSubmit"
       OnCancel="@(() => modalVisible = false)"
       ConfirmLoading="@saving">
    <Form Model="@currentNode" LabelCol="new ColLayoutParam { Span = 6 }" WrapperCol="new ColLayoutParam { Span = 18 }">
        <FormItem Label="Address" Required>
            <Input @bind-Value="@context.Address" Placeholder="http://localhost:5000" />
        </FormItem>
        <FormItem Label="Remark">
            <TextArea @bind-Value="@context.Remark" Placeholder="Enter remark" Rows="3" />
        </FormItem>
        <FormItem Label="Status">
            <Switch @bind-Checked="@statusChecked" CheckedChildren="Online" UnCheckedChildren="Offline" />
        </FormItem>
    </Form>
</Modal>

@code {
    private List<ServerNodeModel> nodes = new();
    private bool loading = false;
    private bool saving = false;

    private bool modalVisible = false;
    private bool isEditMode = false;
    private ServerNodeModel currentNode = new();
    private bool statusChecked = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadNodes();

        var timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadNodes();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task LoadNodes()
    {
        loading = true;
        StateHasChanged();

        try
        {
            var response = await ApiClient.GetAsync<ApiResponse<List<ServerNodeModel>>>("/api/serverNode");
            if (response?.Success == true && response.Data != null)
            {
                nodes = response.Data;
            }
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private void ShowAddModal()
    {
        isEditMode = false;
        currentNode = new ServerNodeModel { Status = 1 };
        statusChecked = true;
        modalVisible = true;
    }

    private void ShowEditModal(ServerNodeModel node)
    {
        isEditMode = true;
        currentNode = new ServerNodeModel
        {
            Id = node.Id,
            Address = node.Address,
            Remark = node.Remark,
            Status = node.Status
        };
        statusChecked = node.Status == 1;
        modalVisible = true;
    }

    private async Task HandleSubmit()
    {
        saving = true;
        currentNode.Status = statusChecked ? 1 : 0;
        StateHasChanged();

        try
        {
            var response = isEditMode
                ? await ApiClient.PutAsync("/api/serverNode", currentNode)
                : await ApiClient.PostAsync("/api/serverNode", currentNode);

            if (response.IsSuccessStatusCode)
            {
                modalVisible = false;
                await LoadNodes();
            }
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }

    private async Task DeleteNode(ServerNodeModel node)
    {
        try
        {
            var response = await ApiClient.DeleteAsync($"/api/serverNode/{node.Id}");
            if (response.IsSuccessStatusCode)
            {
                await LoadNodes();
            }
        }
        catch { }
    }
}
