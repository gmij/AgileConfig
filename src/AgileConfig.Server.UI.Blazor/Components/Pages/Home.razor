@page "/"
@inherits HomeBase

<PageTitle>Home - AgileConfig</PageTitle>

<div class="page-header">
    <h1>Dashboard</h1>
</div>

<div class="page-content">
    <Space Direction="DirectionVHType.Vertical" Size="@("large")" Style="width: 100%;">
        <SpaceItem>
            <Row Gutter="16">
                <AntDesign.Col Span="6">
                    <Card>
                        <Statistic TValue="int"
                                  Title="Applications"
                                  Value="@statistics.AppCount"
                                  Prefix="@IconRender(IconType.Outline.AppstoreAdd)" />
                    </Card>
                </AntDesign.Col>
                <AntDesign.Col Span="6">
                    <Card>
                        <Statistic TValue="int"
                                  Title="Configurations"
                                  Value="@statistics.ConfigCount"
                                  Prefix="@IconRender(IconType.Outline.Setting)" />
                    </Card>
                </AntDesign.Col>
                <AntDesign.Col Span="6">
                    <Card>
                        <Statistic TValue="string"
                                  Title="Server Nodes"
                                  ValueTemplate="@NodeValueTemplate"
                                  Prefix="@IconRender(IconType.Outline.Cluster)" />
                    </Card>
                </AntDesign.Col>
                <AntDesign.Col Span="6">
                    <Card>
                        <Statistic TValue="int"
                                  Title="Connected Clients"
                                  Value="@statistics.ClientCount"
                                  Prefix="@IconRender(IconType.Outline.ApiOutlined)" />
                    </Card>
                </AntDesign.Col>
            </Row>
        </SpaceItem>

        <SpaceItem>
            <Card Title="Recently Visited Applications">
                @if (recentApps.Any())
                {
                    @foreach (var app in recentApps)
                    {
                        <div class="app-list-item">
                            <div class="app-avatar">
                                <Avatar Icon="@IconType.Outline.AppstoreAdd" />
                            </div>
                            <div class="app-info">
                                <div class="app-title">
                                    <a @onclick="() => NavigateToConfigs(app)" class="app-link">
                                        @app.Name
                                    </a>
                                </div>
                                <div class="app-description">
                                    <Text Type="@TextElementType.Secondary">ID: @app.Id</Text>
                                    @if (!string.IsNullOrEmpty(app.Group))
                                    {
                                        <Tag>@app.Group</Tag>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <Empty Description="No recently visited applications" />
                }
            </Card>
        </SpaceItem>

        <SpaceItem>
            <Row Gutter="16">
                <AntDesign.Col Span="12">
                    <Card Title="Server Nodes Status" Loading="@loading">
                        @if (serverNodes.Any())
                        {
                            <Table TItem="ServerNodeModel"
                                   DataSource="@serverNodes"
                                   Size="@TableSize.Small"
                                   Pagination="false">
                                <PropertyColumn Property="n => n.Address" Title="Address" />
                                <PropertyColumn Property="n => n.Status" Title="Status">
                                    @if (context.Status == 1)
                                    {
                                        <Badge Status="@PresetColor.Success.ToString()" Text="Online" />
                                    }
                                    else
                                    {
                                        <Badge Status="@PresetColor.Default.ToString()" Text="Offline" />
                                    }
                                </PropertyColumn>
                                <PropertyColumn Property="n => n.LastHeartbeatTime" Title="Last Heartbeat">
                                    @context.LastHeartbeatTime?.ToString("yyyy-MM-dd HH:mm:ss")
                                </PropertyColumn>
                            </Table>
                        }
                        else
                        {
                            <Empty Description="No server nodes" />
                        }
                    </Card>
                </AntDesign.Col>
                <AntDesign.Col Span="12">
                    <Card Title="Recent Activities" Loading="@loading">
                        @if (recentLogs.Any())
                        {
                            <Timeline>
                                @foreach (var log in recentLogs)
                                {
                                    <TimelineItem Color="blue">
                                        <div>
                                            <Text Strong>@log.LogType</Text>
                                            <br />
                                            <Text Type="@TextElementType.Secondary" Style="font-size: 12px;">
                                                @log.LogTime
                                            </Text>
                                            <br />
                                            <Text>@log.LogText</Text>
                                        </div>
                                    </TimelineItem>
                                }
                            </Timeline>
                        }
                        else
                        {
                            <Empty Description="No recent activities" />
                        }
                    </Card>
                </AntDesign.Col>
            </Row>
        </SpaceItem>
    </Space>
</div>
