@page "/services"
@attribute [Authorize]
@inherits ServiceListBase
@using AgileConfig.Server.UI.Blazor.Models

<PageTitle>Services - AgileConfig</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1>Service Registry</h1>
    </div>
</div>

<div class="page-content">
    <div class="search-panel">
        <Form Model="@searchModel" Layout="@FormLayout.Inline">
            <FormItem Label="Service ID">
                <Input @bind-Value="@searchModel.ServiceId" Placeholder="Search by service ID" Style="width: 200px;" />
            </FormItem>
            <FormItem Label="Service Name">
                <Input @bind-Value="@searchModel.ServiceName" Placeholder="Search by service name" Style="width: 200px;" />
            </FormItem>
            <FormItem Label="Status">
                <Select TItemValue="string"
                        TItem="string"
                        @bind-Value="@searchModel.Status"
                        Placeholder="All"
                        Style="width: 150px;"
                        AllowClear>
                    <SelectOption TItemValue="string" TItem="string" Value="@("Healthy")" Label="Healthy" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("Unhealthy")" Label="Unhealthy" />
                </Select>
            </FormItem>
            <FormItem>
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="@HandleSearch">Search</Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Button OnClick="@HandleReset">Reset</Button>
                    </SpaceItem>
                </Space>
            </FormItem>
        </Form>
    </div>
    <Table TItem="ServiceInfoModel"
           DataSource="@filteredServices"
           Loading="@loading">
        <PropertyColumn Property="s => s.ServiceId" Title="Service ID" />
        <PropertyColumn Property="s => s.ServiceName" Title="Service Name" />
        <PropertyColumn Property="s => s.Ip" Title="IP Address" />
        <PropertyColumn Property="s => s.Port" Title="Port" />
        <PropertyColumn Property="s => s.Status" Title="Status">
            @if (context.Status == "Healthy")
            {
                <Badge Status="@BadgeStatus.Success" Text="Healthy" />
            }
            else
            {
                <Badge Status="@BadgeStatus.Error" Text="Unhealthy" />
            }
        </PropertyColumn>
        <PropertyColumn Property="s => s.RegisterTime" Title="Register Time">
            @context.RegisterTime?.ToString("yyyy-MM-dd HH:mm:ss")
        </PropertyColumn>
        <PropertyColumn Property="s => s.HeartbeatTime" Title="Last Heartbeat">
            @context.HeartbeatTime?.ToString("yyyy-MM-dd HH:mm:ss")
        </PropertyColumn>
        <ActionColumn Title="Actions">
            <Popconfirm Title="@($"Unregister service {context.ServiceName}?")" OnConfirm="@(() => UnregisterService(context))">
                <Button Type="@ButtonType.Link" Danger>Unregister</Button>
            </Popconfirm>
        </ActionColumn>
    </Table>
</div>
