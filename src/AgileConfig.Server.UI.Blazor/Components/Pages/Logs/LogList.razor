@page "/logs"
@using AgileConfig.Server.UI.Blazor.Services
@using AgileConfig.Server.UI.Blazor.Models
@inject ApiClient ApiClient

<PageTitle>System Logs - AgileConfig</PageTitle>

<PageContainer Title="System Logs">
    <ChildContent>
        <Table TItem="SysLogModel"
               DataSource="@logs"
               Loading="@loading"
               @bind-PageIndex="@pageIndex"
               @bind-PageSize="@pageSize"
               Total="@total">
            <PropertyColumn Property="l => l.LogType" Title="Type">
                <Tag Color="blue">@context.LogType</Tag>
            </PropertyColumn>
            <PropertyColumn Property="l => l.AppId" Title="App ID" />
            <PropertyColumn Property="l => l.LogTime" Title="Time">
                @context.LogTime
            </PropertyColumn>
            <PropertyColumn Property="l => l.LogText" Title="Content" Ellipsis>
                @context.LogText
            </PropertyColumn>
        </Table>
    </ChildContent>
</PageContainer>

@code {
    private List<SysLogModel> logs = new();
    private bool loading = false;
    private int pageIndex = 1;
    private int pageSize = 20;
    private int total = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        loading = true;
        StateHasChanged();

        try
        {
            var response = await ApiClient.GetAsync<ApiResponse<PagedResult<SysLogModel>>>($"/api/log?current={pageIndex}&pageSize={pageSize}");
            if (response?.Success == true && response.Data != null)
            {
                logs = response.Data.Data ?? new();
                total = response.Data.Total;
            }
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }
}
