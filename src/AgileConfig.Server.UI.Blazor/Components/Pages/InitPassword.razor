@page "/initpassword"
@rendermode InteractiveServer
@using AgileConfig.Server.UI.Blazor.Services
@using Microsoft.AspNetCore.Authorization
@inherits InitPasswordBase
@attribute [AllowAnonymous]

<div class="login-container">
    <div class="login-box">
        <div class="login-header">
            <h2>Initialize Administrator Password</h2>
            <p>Please set the initial password for the administrator account</p>
        </div>

        <Form Model="@initPasswordModel" OnFinish="OnFinish" LabelColSpan="24" WrapperColSpan="24">
            <FormItem Label="Password" Rules="@passwordRules">
                <InputPassword @bind-Value="@context.Password" Placeholder="Enter password" Size="@InputSize.Large" />
            </FormItem>

            <FormItem Label="Confirm Password" Rules="@confirmPasswordRules">
                <InputPassword @bind-Value="@context.ConfirmPassword" Placeholder="Confirm password" Size="@InputSize.Large" />
            </FormItem>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <Alert Type="@AlertType.Error" Message="@errorMessage" ShowIcon="true" Style="margin-bottom: 16px;" />
            }

            <FormItem WrapperColSpan="24">
                <Button Type="@ButtonType.Primary" HtmlType="submit" Block="true" Size="@ButtonSize.Large" Loading="@isLoading">
                    Initialize Password
                </Button>
            </FormItem>
        </Form>
    </div>
</div>

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .login-box {
        background: white;
        padding: 40px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 400px;
    }

    .login-header {
        text-align: center;
        margin-bottom: 32px;
    }

    .login-header h2 {
        margin-bottom: 8px;
        color: #333;
    }

    .login-header p {
        color: #666;
        font-size: 14px;
    }
</style>
