@page "/users"
@attribute [Authorize]
@inherits UserListBase
@using AgileConfig.Server.UI.Blazor.Models

<PageTitle>Users - AgileConfig</PageTitle>

<div class="page-header">
    <div class="page-header-content">
        <h1>User Management</h1>
        <div class="page-header-extra">
            <Space>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" Icon="@IconType.Outline.Plus" OnClick="@ShowAddModal">
                        Add User
                    </Button>
                </SpaceItem>
            </Space>
        </div>
    </div>
</div>

<div class="page-content">
    <div class="search-panel">
        <Form Model="@searchModel" Layout="@FormLayout.Inline">
            <FormItem Label="Username">
                <Input @bind-Value="@searchModel.UserName" Placeholder="Search by username" Style="width: 200px;" />
            </FormItem>
            <FormItem Label="Role">
                <Select TItemValue="string"
                        TItem="string"
                        @bind-Value="@searchModel.Role"
                        Placeholder="All"
                        Style="width: 150px;"
                        AllowClear>
                    <SelectOption TItemValue="string" TItem="string" Value="@("SuperAdmin")" Label="Super Admin" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("Administrator")" Label="Administrator" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("Operator")" Label="Operator" />
                </Select>
            </FormItem>
            <FormItem Label="Status">
                <Select TItemValue="bool?"
                        TItem="string"
                        @bind-Value="@searchModel.Enabled"
                        Placeholder="All"
                        Style="width: 120px;"
                        AllowClear>
                    <SelectOption TItemValue="bool?" TItem="string" Value="@(true)" Label="Enabled" />
                    <SelectOption TItemValue="bool?" TItem="string" Value="@(false)" Label="Disabled" />
                </Select>
            </FormItem>
            <FormItem>
                <Space>
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" OnClick="@HandleSearch">Search</Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Button OnClick="@HandleReset">Reset</Button>
                    </SpaceItem>
                </Space>
            </FormItem>
        </Form>
    </div>
    <Table TItem="UserModel"
           DataSource="@filteredUsers"
           Loading="@loading"
           @bind-PageIndex="@pageIndex"
           @bind-PageSize="@pageSize"
           Total="@total">
        <PropertyColumn Property="u => u.UserName" Title="Username" />
        <PropertyColumn Property="u => u.Email" Title="Email" />
        <PropertyColumn Property="u => u.Roles" Title="Roles">
            @if (context.Roles != null)
            {
                @foreach (var role in context.Roles)
                {
                    <Tag Color="@("blue")">@role</Tag>
                }
            }
        </PropertyColumn>
        <PropertyColumn Property="u => u.Enabled" Title="Status">
            @if (context.Enabled)
            {
                <Badge Status="@BadgeStatus.Success" Text="Enabled" />
            }
            else
            {
                <Badge Status="@BadgeStatus.Default" Text="Disabled" />
            }
        </PropertyColumn>
        <PropertyColumn Property="u => u.CreateTime" Title="Create Time">
            @context.CreateTime?.ToString("yyyy-MM-dd HH:mm:ss")
        </PropertyColumn>
        <ActionColumn Title="Actions">
            <Space>
                <SpaceItem>
                    <Button Type="@ButtonType.Link" OnClick="@(() => ShowEditModal(context))">Edit</Button>
                </SpaceItem>
                <SpaceItem>
                    <Button Type="@ButtonType.Link" OnClick="@(() => ToggleUserStatus(context))">
                        @(context.Enabled ? "Disable" : "Enable")
                    </Button>
                </SpaceItem>
                <SpaceItem>
                    <Popconfirm Title="@($"Delete user {context.UserName}?")" OnConfirm="@(() => DeleteUser(context))">
                        <Button Type="@ButtonType.Link" Danger>Delete</Button>
                    </Popconfirm>
                </SpaceItem>
            </Space>
        </ActionColumn>
    </Table>
</div>

<Modal Title="@(isEditMode ? "Edit User" : "Add User")"
       @bind-Visible="@modalVisible"
       OnOk="@HandleSubmit"
       OnCancel="@(() => modalVisible = false)"
       ConfirmLoading="@saving">
    <Form Model="@currentUser" LabelCol="new ColLayoutParam { Span = 6 }" WrapperCol="new ColLayoutParam { Span = 18 }">
        <ChildContent Context="formContext">
            <FormItem Label="Username" Required>
                <Input @bind-Value="@formContext.UserName" Placeholder="Enter username" Disabled="@isEditMode" />
            </FormItem>
            <FormItem Label="Password" Required="@(!isEditMode)">
                <InputPassword @bind-Value="@formContext.Password" Placeholder="@(isEditMode ? "Leave blank to keep current" : "Enter password")" />
            </FormItem>
            <FormItem Label="Email">
                <Input @bind-Value="@formContext.Email" Placeholder="Enter email" />
            </FormItem>
            <FormItem Label="Roles">
                <Select TItemValue="string"
                        TItem="string"
                        Values="@formContext.Roles"
                        ValuesChanged="@((values) => formContext.Roles = values.ToList())"
                        Mode="@SelectMode.Multiple"
                        Placeholder="Select roles">
                    <SelectOption TItemValue="string" TItem="string" Value="@("SuperAdmin")" Label="Super Admin" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("Administrator")" Label="Administrator" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("Operator")" Label="Operator" />
                </Select>
            </FormItem>
            <FormItem Label="Enabled">
                <Switch @bind-Checked="@formContext.Enabled" />
            </FormItem>
        </ChildContent>
    </Form>
</Modal>
