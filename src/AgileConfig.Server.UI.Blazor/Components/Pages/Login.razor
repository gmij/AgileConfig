@page "/login"
@using AgileConfig.Server.UI.Blazor.Services
@using Microsoft.AspNetCore.Authorization
@inherits LoginBase
@attribute [AllowAnonymous]

<PageTitle>Login - AgileConfig</PageTitle>

<div class="login-container">
    <Card Title="AgileConfig Login" Class="login-card">
        <Body>
            <Form Model="@loginModel" OnFinish="OnFinish" LabelColSpan="6" WrapperColSpan="18">
                <FormItem Label="Username">
                    <Input @bind-Value="@context.Username" Placeholder="Enter username" />
                </FormItem>
                <FormItem Label="Password">
                    <InputPassword @bind-Value="@context.Password" Placeholder="Enter password" />
                </FormItem>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <Alert Type="@AlertType.Error" Message="@errorMessage" ShowIcon="true" Closable="true" />
                }
                <FormItem WrapperColOffset="6" WrapperColSpan="18">
                    <Button Type="@ButtonType.Primary" HtmlType="submit" Loading="@isLoading" Block>
                        Login
                    </Button>
                </FormItem>
            </Form>
        </Body>
    </Card>
</div>
